{
  "name": "claude-multi-account",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@claude-notch/web --filter=@claude-notch/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @claude-notch/db generate",
    "db:migrate": "pnpm --filter @claude-notch/db migrate",
    "db:studio": "pnpm --filter @claude-notch/db studio",
    "notch:app": "pnpm --filter @claude-notch/notch app",
    "notch:install": "pnpm --filter @claude-notch/notch install-app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}
